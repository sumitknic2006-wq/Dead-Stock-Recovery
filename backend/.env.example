# StockSaathi AI — Backend Environment Variables Template
# Port configuration: Defaults to 5001 locally if port 5000 is occupied by macOS AirPlay Receiver
PORT=5001
NODE_ENV=development

# Allowed frontend origins for CORS
CLIENT_URL=http://localhost:5173

# JWT Authentication Secrets
JWT_SECRET=replace_with_secure_random_secret_in_production
JWT_EXPIRES_IN=7d

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/<database-name>?retryWrites=true&w=majority
# Replace with your actual credentials in local backend/.env (Note: encode special characters in password)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/stocksaathi?retryWrites=true&w=majority
